{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theparitt.github.io/sppa-protocol/schemas/0.1.0/signature.schema.json",
  "title": "SPPA signature (Draft 0.1.0)",
  "type": "object",
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "value": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "algorithm",
    "key_id",
    "value"
  ],
  "additionalProperties": false
}
