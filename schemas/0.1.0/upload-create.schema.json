{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theparitt.github.io/sppa-protocol/schemas/0.1.0/upload-create.schema.json",
  "title": "SPPA upload-create (Draft 0.1.0)",
  "type": "object",
  "properties": {
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "confidential",
        "local_only"
      ]
    },
    "retention_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  },
  "required": [
    "media_type",
    "size_bytes",
    "sha256",
    "privacy",
    "retention_seconds"
  ],
  "additionalProperties": false
}
