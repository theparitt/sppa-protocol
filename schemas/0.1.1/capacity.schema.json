{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theparitt.github.io/sppa-protocol/schemas/0.1.1/capacity.schema.json",
  "title": "SPPA capacity (Draft 0.1.1)",
  "type": "object",
  "properties": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "capability_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "accepting_jobs": {
      "type": "boolean"
    },
    "capacity": {
      "type": "object",
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_concurrency",
        "running",
        "available"
      ],
      "additionalProperties": false
    },
    "queue": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimated_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "depth",
        "max_depth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "capability",
    "capability_version",
    "accepting_jobs",
    "capacity",
    "queue"
  ],
  "additionalProperties": false
}
