{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theparitt.github.io/sppa-protocol/schemas/0.1.1/execution.schema.json",
  "title": "SPPA execution (Draft 0.1.1)",
  "type": "object",
  "properties": {
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "queue": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy": {
          "const": "fifo"
        }
      },
      "required": [
        "enabled",
        "max_depth",
        "policy"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "max_depth": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "rate_limit": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "scope": {
          "const": "caller"
        }
      },
      "required": [
        "requests",
        "window_seconds",
        "scope"
      ],
      "additionalProperties": false
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "retry": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "supported",
        "max_attempts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "supported": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "max_attempts": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "max_concurrency",
    "queue",
    "rate_limit",
    "timeout_seconds",
    "retry"
  ],
  "additionalProperties": false
}
