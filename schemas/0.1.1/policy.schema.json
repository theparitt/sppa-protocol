{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theparitt.github.io/sppa-protocol/schemas/0.1.1/policy.schema.json",
  "title": "SPPA policy (Draft 0.1.1)",
  "type": "object",
  "properties": {
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "confidential",
        "local_only"
      ]
    },
    "execution_location": {
      "type": "string",
      "enum": [
        "local",
        "private_network",
        "remote"
      ]
    },
    "data_region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "training_use": {
      "type": "boolean"
    },
    "max_retention_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allow_content_logging": {
      "type": "boolean"
    },
    "granted_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "human_approval": {
      "type": "string",
      "enum": [
        "not_required",
        "approved",
        "pending"
      ]
    }
  },
  "required": [
    "privacy",
    "execution_location",
    "data_region",
    "training_use",
    "max_retention_seconds",
    "allow_content_logging",
    "granted_permissions",
    "human_approval"
  ],
  "additionalProperties": false
}
