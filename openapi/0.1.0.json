{
  "openapi": "3.1.1",
  "info": {
    "title": "SPPA Core HTTP-artifact binding",
    "version": "0.1.0",
    "description": "Working draft. Provider binding, not Hub search API. Production requires HTTPS; loopback reference is a development harness.",
