    "/v1/transfers/{transfer_id}/bytes": {
      "put": {
        "operationId": "putTransferBytes",
        "summary": "PUT temporary authorized transfer bytes",
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^transfer_[A-Za-z0-9_-]{8,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bytes verified (PUT) or immutable bytes (GET)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received_bytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "received_bytes"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Authentication, ownership, integrity, state or expiry failure",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://theparitt.github.io/sppa-protocol/schemas/0.1.0/envelope.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "error"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getTransferBytes",
        "summary": "GET temporary authorized transfer bytes",
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^transfer_[A-Za-z0-9_-]{8,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bytes verified (PUT) or immutable bytes (GET)",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, ownership, integrity, state or expiry failure",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://theparitt.github.io/sppa-protocol/schemas/0.1.0/envelope.schema.json"
